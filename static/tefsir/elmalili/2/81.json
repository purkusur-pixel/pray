class=\"ea\" width=\"133\" height=\"40\" viewBox=\"0 0 132.6 40.4\"><text x=\"3.0 16.4 27.0 35.3 35.3 48.7 48.7 56.3 56.3 63.0 63.0 78.7 78.7 87.7 87.7 94.4 94.4 101.3 108.0\" y=\"25.6 25.6 25.6 25.6 25.6 25.6 26.3 25.6 25.6 25.6 25.6 25.6 25.6 25.6 25.6 25.6 25.6 25.6 25.6\" class=\"A3\" font-size=\"20.2\"></text><text x=\"16.4 101.3 108.0 116.3\" y=\"25.6\" class=\"A3b\" font-size=\"20.2\"></text></svg> siz hâlâ o i'razda devam edip gitmektesiniz. -Bunlarda böyle olduğunuz gibi doğrudan doğru hakkı hayatınızla alâkadar olan misaklarda da böylesiniz. Bakınız:</p>"}