# Veri kaynağı
#   ezanvakti : https://ezanvakti.emushaf.net — ücretsiz, HESAP GEREKMEZ (varsayılan)
#   diyanet   : https://awqatsalah.diyanet.gov.tr — resmi, ücretsiz ama hesap gerekir
PROVIDER=ezanvakti

# Yalnızca PROVIDER=diyanet için
# AWQAT_EMAIL=ornek@eposta.com
# AWQAT_PASSWORD=sifreniz

# Dış kaynağa endpoint başına günlük en fazla istek
# (varsayılan: ezanvakti 10, diyanet 5)
# QUOTA_PER_ENDPOINT_PER_DAY=10

# 1 yapılırsa dış kaynağa hiç gidilmez, sahte veriyle çalışır (geliştirme için)
MOCK=0

# Sitenin alan adı (başka Host ile gelen istekler reddedilir)
ALLOWED_HOSTS=namaz.sporyazilimlari.com.tr

# Uygulamanın sunucu içi portu (yalnızca 127.0.0.1, dışarıya açık değil).
# Boş bırakılırsa kurulum 8070'ten başlayarak boş bir port seçip buraya yazar.
# NAMAZ_PORT=8070

# İsteğe bağlı
# MAX_DAYS=14
# PLACES_TTL_DAYS=30
# LOOKUP_TTL_DAYS=30
# CLIENT_RATE_PER_MIN=60
